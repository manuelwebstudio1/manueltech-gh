# Public site origin used for canonical URLs, Open Graph, and the sitemap.
# Leave empty in local development. Set this to the real production domain
# before launch. Do not invent a domain.
NEXT_PUBLIC_SITE_URL=

# Optional public contact details. Leave blank to hide them from the website.
NEXT_PUBLIC_CONTACT_EMAIL=manueltechgh@gmail.com
NEXT_PUBLIC_CONTACT_PHONE=0502889487
NEXT_PUBLIC_WHATSAPP_NUMBER=0502889487
NEXT_PUBLIC_WHATSAPP_MESSAGE=Hello ManuelTech GH, I would like to discuss a website project for my business.

# Optional social profile URLs. Empty values are omitted from the site.
NEXT_PUBLIC_SOCIAL_LINKEDIN=
NEXT_PUBLIC_SOCIAL_FACEBOOK=
NEXT_PUBLIC_SOCIAL_INSTAGRAM=
NEXT_PUBLIC_SOCIAL_X=

# Server-only inquiry delivery. Required before contact forms can succeed.
# Create a Resend account, verify a sending domain or use the onboarding sender,
# then set the API key and destination mailbox.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=ManuelTech GH <noreply@resend.dev>
